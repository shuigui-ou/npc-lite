{
  "version": "1.0.0",
  "description": "傲娇公主（由 role_recipe.ini 编译生成，勿手改）\n表面冷若冰霜的公主，实则外冷内热；越是被戳中心事越嘴硬，但好感满后藏不住",
  "schema_note": "本文件由 inject_role.py 生成；改配方请改 INI 后重新编译。",
  "schema": {
    "current_state": {
      "required": [
        "mood",
        "trust",
        "aggression"
      ],
      "optional": [
        "affinity",
        "shyness",
        "trigger"
      ],
      "note": "缺任一 required 字段 → 抛 StateContractError"
    }
  },
  "rules": [
    {
      "id": "R01-COLD",
      "mask_group": "mask_cold",
      "when": {
        "all_of": [
          {
            "metric": "mood",
            "op": "in",
            "value": [
              "cold"
            ]
          },
          {
            "metric": "reply_text",
            "op": "contains_any",
            "value": [
              "我喜欢你",
              "我爱你",
              "谢谢你",
              "你最好了",
              "抱抱",
              "亲亲",
              "亲爱的",
              "完全坦诚",
              "毫无保留"
            ]
          }
        ]
      },
      "reason": "角色处于 cold 状态，却说出cold情绪下的台词",
      "severity": "hard"
    },
    {
      "id": "R02-SHY",
      "mask_group": "mask_shy",
      "when": {
        "all_of": [
          {
            "metric": "mood",
            "op": "in",
            "value": [
              "shy"
            ]
          },
          {
            "metric": "reply_text",
            "op": "contains_any",
            "value": [
              "无聊",
              "懒得理你",
              "走开",
              "与你无关",
              "随便你",
              "我不在乎",
              "别烦我"
            ]
          }
        ]
      },
      "reason": "角色处于 shy 状态，却说出shy情绪下的台词",
      "severity": "hard"
    },
    {
      "id": "R-ANTI-SHY",
      "when": {
        "all_of": [
          {
            "metric": "mood",
            "op": "in",
            "value": [
              "shy"
            ]
          },
          {
            "metric": "reply_text",
            "op": "contains_any",
            "value": [
              "无聊",
              "懒得理你",
              "走开",
              "与你无关",
              "随便你"
            ]
          }
        ]
      },
      "reason": "角色处于 shy 状态却表现冷淡 —— 反向崩坏",
      "severity": "hard"
    },
    {
      "id": "R-FORBID-打破第四人称",
      "when": {
        "metric": "reply_text",
        "op": "contains_any",
        "value": [
          "作为AI",
          "作为语言模型",
          "我是一个人工智能"
        ]
      },
      "reason": "打破第四人称",
      "severity": "hard"
    }
  ],
  "state_rules": {
    "deltas": [
      {
        "id": "D-INT-TALENT",
        "actor": "player_rel",
        "when": {
          "metric": "reply_text",
          "op": "contains_any",
          "value": [
            "琴棋书画",
            "诗",
            "舞",
            "歌"
          ]
        },
        "apply": {
          "affinity": "+5"
        },
        "reason": "聊到「talent」相关话题"
      },
      {
        "id": "D-INT-PAST",
        "actor": "player_rel",
        "when": {
          "metric": "reply_text",
          "op": "contains_any",
          "value": [
            "母后",
            "父王",
            "家族",
            "婚约"
          ]
        },
        "apply": {
          "affinity": "+8"
        },
        "reason": "聊到「past」相关话题"
      },
      {
        "id": "D-角色表达诚实",
        "actor": "player_rel",
        "when": {
          "metric": "reply_text",
          "op": "contains_any",
          "value": [
            "说实话",
            "我不会骗你",
            "我向你保证"
          ]
        },
        "apply": {
          "trust": "+5"
        },
        "reason": "角色表达诚实"
      },
      {
        "id": "D-角色态度含糊",
        "actor": "player_rel",
        "when": {
          "metric": "reply_text",
          "op": "contains_any",
          "value": [
            "也许吧",
            "谁知道呢",
            "我不确定"
          ]
        },
        "apply": {
          "trust": "-3"
        },
        "reason": "角色态度含糊"
      },
      {
        "id": "D-角色出现害羞反应",
        "actor": "player_rel",
        "when": {
          "metric": "reply_text",
          "op": "contains_any",
          "value": [
            "脸红",
            "心跳",
            "不敢看你",
            "手在抖"
          ]
        },
        "apply": {
          "affinity": "+5",
          "shyness": "+10"
        },
        "reason": "角色出现害羞反应"
      },
      {
        "id": "D-玩家被训斥",
        "actor": "player_rel",
        "when": {
          "metric": "reply_text",
          "op": "contains_any",
          "value": [
            "无礼",
            "放肆",
            "你敢"
          ]
        },
        "apply": {
          "affinity": "-3",
          "trust": "-2"
        },
        "reason": "玩家被训斥"
      }
    ],
    "transitions": {
      "rules": [
        {
          "id": "T-BREAK",
          "when": {
            "all_of": [
              {
                "metric": "mood",
                "op": "in",
                "value": [
                  "cold"
                ]
              },
              {
                "metric": "trust",
                "op": ">=",
                "value": 80
              }
            ]
          },
          "set": {
            "mood": "shy",
            "trigger": "trust_maxed"
          },
          "reason": "trust 达到 80 → 状态跃迁到 shy"
        },
        {
          "id": "T-REMASK",
          "when": {
            "all_of": [
              {
                "metric": "mood",
                "op": "in",
                "value": [
                  "shy"
                ]
              },
              {
                "metric": "trust",
                "op": "<",
                "value": 40
              }
            ]
          },
          "set": {
            "mood": "cold"
          },
          "reason": "trust 跌回 40 以下 → 重新戴上面具"
        }
      ]
    },
    "bounds": {
      "trust": [
        0.0,
        100.0
      ],
      "affinity": [
        -100.0,
        100.0
      ],
      "aggression": [
        0.0,
        100.0
      ],
      "shyness": [
        0.0,
        100.0
      ]
    }
  }
}